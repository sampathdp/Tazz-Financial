APP_NAME="ABSL Financial"
APP_ENV=production
# Generate on the server after uploading: php artisan key:generate --show
# then paste the "base64:..." output here.
APP_KEY=
APP_DEBUG=false
APP_URL=https://absl.salonflow.cloud/api

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=30
LOG_REQUEST_DAYS=14
LOG_AUDIT_DAYS=90
LOG_SECURITY_DAYS=90
LOG_PERF_DAYS=14
LOG_ERROR_DAYS=60

# Security
CORS_ALLOWED_ORIGINS=https://absl.salonflow.cloud
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=false
SANCTUM_EXPIRATION_MINUTES=720
# Guards public/opcache-reset.php. Set a unique value for this environment
# — never reuse the value from another site's env file. Generated locally via:
# php -r "echo bin2hex(random_bytes(32));" — regenerate before going live if
# this file is ever shared/exposed.
OPS_TOKEN=6befcd251dc3e7bcd5ae0d560288dbe1ece39d2a65f397fb855ff9625ab86d36

# Performance
DB_SLOW_QUERY_MS=500

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# TODO: fill in from cPanel > MySQL Databases for this account (usually prefixed, e.g. zemimycf_absl)
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# TODO: fill in from cPanel > Email Accounts if this app sends mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
